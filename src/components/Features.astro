---
---

<section class="features" id="features">
    <div class="container">
        <div class="section-header">
            <p class="section-label">Why Openza</p>
            <h2 class="section-title">Built Different</h2>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon cyan">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                </div>
                <h3>Fast & Lightweight</h3>
                <p>Built with native desktop stacks for smooth, responsive performance. Quick to launch, easy on resources.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon purple">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                </div>
                <h3>Secure by Design</h3>
                <p>Local-first defaults, careful permissions, and conservative handling of untrusted content. Your data stays yours.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon green">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                    </svg>
                </div>
                <h3>Open Source</h3>
                <p>MIT licensed, community-driven, transparent development. Fork it, improve it, share it.</p>
            </div>
        </div>
    </div>
</section>

<style>
    .features {
        padding: 120px 0;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 24px;
    }

    .feature-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 32px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .feature-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--accent-cyan), transparent);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .feature-card:hover {
        border-color: rgba(0, 217, 255, 0.3);
        transform: translateY(-4px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .feature-card:hover::before {
        opacity: 1;
    }

    .feature-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        margin-bottom: 20px;
        font-size: 1.5rem;
    }

    .feature-icon.cyan {
        background: var(--accent-cyan-dim);
        color: var(--accent-cyan);
    }

    .feature-icon.purple {
        background: rgba(163, 113, 247, 0.15);
        color: var(--accent-purple);
    }

    .feature-icon.green {
        background: rgba(63, 185, 80, 0.15);
        color: var(--accent-green);
    }

    .feature-card h3 {
        font-family: var(--font-mono);
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .feature-card p {
        color: var(--text-secondary);
        font-size: 0.95rem;
    }
</style>
