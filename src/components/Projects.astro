---
import { TASKS_FALLBACK_VERSION, TASKS_STORE_URL, getAllProjectReleases } from '../lib/github';

const releases = await getAllProjectReleases();
const tasksVersion = releases.tasks?.version ?? TASKS_FALLBACK_VERSION;
const flowVersion = releases.flow?.version ?? 'v0.1.0';
---

<section class="projects" id="projects">
    <div class="container">
        <div class="section-header">
            <p class="section-label">Our Projects</p>
            <h2 class="section-title">Tools We're Building</h2>
        </div>
        <div class="projects-grid">
            <!-- Openza Tasks -->
            <div class="project-card">
                <div class="project-content">
                    <h3>
                        Openza Tasks
                        <span class="project-badge">{tasksVersion}</span>
                    </h3>
                    <p>Windows-native, local-first task management with SQLite, Todoist and Microsoft To Do sync, local restore points, and optional OneDrive backup.</p>
                    <div class="project-links">
                        <a href={TASKS_STORE_URL} class="btn btn-primary">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                            Get on Microsoft Store
                        </a>
                        <a href="/projects/tasks" class="project-link">
                            Learn More
                            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                    </div>
                </div>
                <div class="project-status">
                    <span class="status-indicator">
                        <span class="status-dot"></span>
                        Store live
                    </span>
                </div>
            </div>

            <!-- Openza Reader -->
            <div class="project-card">
                <div class="project-content">
                    <h3>
                        Openza Reader
                        <span class="project-badge">pre-release</span>
                    </h3>
                    <p>Fast, read-only Markdown reader for Windows. Open README files safely with good typography, TOC navigation, search, zoom, and auto reload.</p>
                    <div class="project-links">
                        <a href="/reader" class="btn btn-primary">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            Read Docs
                        </a>
                        <a href="https://github.com/openza/reader" target="_blank" class="project-link">
                            View Repository
                            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                    </div>
                </div>
                <div class="project-status">
                    <span class="status-indicator">
                        <span class="status-dot"></span>
                        Preview
                    </span>
                </div>
            </div>

            <!-- Openza Flow -->
            <div class="project-card">
                <div class="project-content">
                    <h3>
                        Openza Flow
                        <span class="project-badge">{flowVersion}</span>
                    </h3>
                    <p>Your GitHub PR review inbox. Track review requests, manage your PRs, and never miss a code review again.</p>
                    <div class="project-links">
                        <a href="/projects/flow" class="btn btn-primary">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                            </svg>
                            Download Free
                        </a>
                        <a href="/flow" class="project-link">
                            Learn More
                            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                    </div>
                </div>
                <div class="project-status">
                    <span class="status-indicator">
                        <span class="status-dot"></span>
                        Released
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .projects {
        padding: 120px 0;
    }

    .projects-grid {
        display: grid;
        gap: 32px;
    }

    .project-card {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 32px;
        align-items: start;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 40px;
        transition: all 0.3s ease;
        position: relative;
    }

    .project-card::before {
        content: '';
        position: absolute;
        inset: -1px;
        border-radius: 20px;
        padding: 1px;
        background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
    }

    .project-card:hover::before {
        opacity: 1;
    }

    .project-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.3);
    }

    .project-content h3 {
        font-family: var(--font-mono);
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .project-badge {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        padding: 4px 10px;
        background: rgba(63, 185, 80, 0.15);
        color: var(--accent-green);
        border-radius: 100px;
        font-weight: 500;
    }

    .project-content p {
        color: var(--text-secondary);
        font-size: 1rem;
        margin-bottom: 24px;
        max-width: 500px;
    }

    .project-links {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .project-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--accent-cyan);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .project-link:hover {
        gap: 12px;
    }

    .project-link svg {
        width: 18px;
        height: 18px;
    }

    .project-status {
        text-align: right;
    }

    .status-indicator {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--accent-green);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        background: var(--accent-green);
        border-radius: 50%;
        animation: pulse 2s ease-in-out infinite;
    }

    @media (max-width: 900px) {
        .project-card {
            grid-template-columns: 1fr;
        }

        .project-status {
            text-align: left;
        }
    }
</style>
