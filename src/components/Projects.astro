<style>
    .projects {
        padding: 120px 0;
    }

    .projects-grid {
        display: grid;
        gap: 32px;
    }

    .project-card {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 32px;
        align-items: start;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 40px;
        transition: all 0.3s ease;
        position: relative;
    }

    .project-card::before {
        content: '';
        position: absolute;
        inset: -1px;
        border-radius: 20px;
        padding: 1px;
        background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .project-card:hover::before {
        opacity: 1;
    }

    .project-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.3);
    }

    .project-content h3 {
        font-family: var(--font-mono);
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .project-badge {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        padding: 4px 10px;
        background: rgba(63, 185, 80, 0.15);
        color: var(--accent-green);
        border-radius: 100px;
        font-weight: 500;
    }

    .project-content p {
        color: var(--text-secondary);
        font-size: 1rem;
        margin-bottom: 24px;
        max-width: 500px;
    }

    .project-tech {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 24px;
    }

    .tech-tag {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        padding: 6px 12px;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        color: var(--text-secondary);
    }

    .project-links {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .project-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--accent-cyan);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .project-link:hover {
        gap: 12px;
    }

    .project-link svg {
        width: 18px;
        height: 18px;
    }

    .project-status {
        text-align: right;
    }

    .status-indicator {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--accent-green);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        background: var(--accent-green);
        border-radius: 50%;
        animation: pulse 2s ease-in-out infinite;
    }

    @media (max-width: 900px) {
        .project-card {
            grid-template-columns: 1fr;
        }

        .project-status {
            text-align: left;
        }
    }
</style>
