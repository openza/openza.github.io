---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getLatestRelease } from '../../lib/github';

const release = await getLatestRelease('flow');
const version = release?.version ?? 'Latest';
---

<Layout title="Openza Flow - GitHub PR Review Inbox" description="Your GitHub PR review inbox. Track review requests, manage your PRs, and never miss a code review again.">
    <Header />
    <main>
        <!-- Hero Section -->
        <section class="hero">
            <div class="container">
                <a href="/#projects" class="back-link">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Back to Projects
                </a>
                <div class="hero-content">
                    <span class="version-badge">{version}</span>
                    <h1>Your PR Inbox,<br><span class="highlight">Simplified</span></h1>
                    <p class="hero-description">
                        Track review requests, manage your pull requests, and never miss a code review again.
                        A clean, focused interface for GitHub workflows.
                    </p>
                    <div class="hero-cta">
                        <a href="#download" class="btn btn-primary">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                            </svg>
                            Download Free
                        </a>
                        <a href="/flow" class="btn btn-secondary">
                            View Documentation
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section class="features">
            <div class="container">
                <div class="section-header">
                    <p class="section-label">Features</p>
                    <h2 class="section-title">Stay on Top of Code Reviews</h2>
                </div>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon cyan">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                            </svg>
                        </div>
                        <h3>PR Review Inbox</h3>
                        <p>See all pull requests waiting for your review in one place. No more searching through notifications.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon purple">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                            </svg>
                        </div>
                        <h3>Track Your PRs</h3>
                        <p>Monitor the status of your own pull requests. See who's reviewed, who's pending, and what needs attention.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon green">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                            </svg>
                        </div>
                        <h3>Organization Filter</h3>
                        <p>Focus on what matters. Filter PRs by organization to work on one team's code at a time.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon orange">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                            </svg>
                        </div>
                        <h3>Desktop Notifications</h3>
                        <p>Get notified when you're requested to review. Never let a PR sit waiting because you missed it.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon cyan">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </div>
                        <h3>Secure OAuth</h3>
                        <p>Sign in with GitHub OAuth Device Flow. Your credentials are never stored—just a secure token.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon purple">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                            </svg>
                        </div>
                        <h3>Quick Actions</h3>
                        <p>Open PRs in browser with one click. Jump straight to the code without digging through GitHub.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- GitHub Integration Section -->
        <section class="integrations">
            <div class="container">
                <div class="section-header">
                    <p class="section-label">Integration</p>
                    <h2 class="section-title">Built for GitHub</h2>
                </div>
                <div class="github-card">
                    <div class="github-icon">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                        </svg>
                    </div>
                    <div class="github-content">
                        <h3>GitHub Integration</h3>
                        <p>Openza Flow connects directly to GitHub using secure OAuth authentication. Access your personal repos, organization repos, and any repository you have review access to.</p>
                        <ul class="github-features">
                            <li>View PRs awaiting your review</li>
                            <li>Track PRs you've created</li>
                            <li>Filter by organization</li>
                            <li>One-click to open in browser</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Download Section -->
        <section class="download" id="download">
            <div class="container">
                <div class="section-header">
                    <p class="section-label">Download</p>
                    <h2 class="section-title">Get Openza Flow</h2>
                    <p class="section-subtitle">Free and open source. Available for Linux and Windows.</p>
                </div>
                <div class="platform-grid">
                    <div class="platform-card">
                        <div class="platform-icon windows">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/>
                            </svg>
                        </div>
                        <h3>Windows</h3>
                        <p class="platform-req">Windows 10 or later (64-bit)</p>
                        {release?.assets.windows ? (
                            <a href={release.assets.windows} class="btn btn-primary download-btn">
                                Download .exe
                            </a>
                        ) : (
                            <span class="unavailable">Not available</span>
                        )}
                    </div>

                    <div class="platform-card">
                        <div class="platform-icon linux">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139z"/>
                            </svg>
                        </div>
                        <h3>Linux (AppImage)</h3>
                        <p class="platform-req">Ubuntu 22.04+, Fedora 35+</p>
                        {release?.assets.appimage ? (
                            <a href={release.assets.appimage} class="btn btn-primary download-btn">
                                Download AppImage
                            </a>
                        ) : (
                            <span class="unavailable">Not available</span>
                        )}
                        <p class="install-hint">chmod +x && run</p>
                    </div>

                    <div class="platform-card">
                        <div class="platform-icon flatpak">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                            </svg>
                        </div>
                        <h3>Linux (Flatpak)</h3>
                        <p class="platform-req">Any Linux with Flatpak</p>
                        {release?.assets.flatpak ? (
                            <a href={release.assets.flatpak} class="btn btn-primary download-btn">
                                Download Flatpak
                            </a>
                        ) : (
                            <span class="unavailable">Not available</span>
                        )}
                        <p class="install-hint">flatpak install</p>
                    </div>
                </div>
                <div class="download-footer">
                    <a href="https://github.com/openza/flow/releases" target="_blank" class="alt-link">
                        All releases on GitHub
                    </a>
                    <a href="/flow/getting-started/installation" class="alt-link">
                        Installation guide
                    </a>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<style>
    /* Hero */
    .hero {
        padding: 140px 0 80px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.9rem;
        margin-bottom: 32px;
        transition: color 0.2s ease;
    }

    .back-link:hover {
        color: var(--accent-cyan);
    }

    .hero-content {
        max-width: 700px;
    }

    .version-badge {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        padding: 6px 14px;
        background: rgba(63, 185, 80, 0.15);
        color: var(--accent-green);
        border-radius: 100px;
        margin-bottom: 24px;
    }

    .hero h1 {
        font-family: var(--font-mono);
        font-size: clamp(2.5rem, 6vw, 3.5rem);
        font-weight: 700;
        line-height: 1.1;
        margin-bottom: 24px;
    }

    .hero h1 .highlight {
        background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-purple) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-description {
        font-size: 1.2rem;
        color: var(--text-secondary);
        margin-bottom: 32px;
        line-height: 1.7;
    }

    .hero-cta {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    /* Features */
    .features {
        padding: 100px 0;
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 24px;
    }

    .feature-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 28px;
        transition: all 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-4px);
        border-color: var(--accent-cyan);
        box-shadow: 0 16px 32px var(--shadow-color);
    }

    .feature-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        margin-bottom: 16px;
    }

    .feature-icon.cyan {
        background: var(--accent-cyan-dim);
        color: var(--accent-cyan);
    }

    .feature-icon.purple {
        background: rgba(163, 113, 247, 0.15);
        color: var(--accent-purple);
    }

    .feature-icon.green {
        background: rgba(63, 185, 80, 0.15);
        color: var(--accent-green);
    }

    .feature-icon.orange {
        background: rgba(240, 136, 62, 0.15);
        color: var(--accent-orange);
    }

    .feature-card h3 {
        font-family: var(--font-mono);
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .feature-card p {
        color: var(--text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    /* GitHub Integration */
    .integrations {
        padding: 100px 0;
    }

    .github-card {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 40px;
        align-items: center;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 48px;
        max-width: 800px;
        margin: 0 auto;
    }

    .github-icon {
        width: 80px;
        height: 80px;
        color: var(--text-primary);
    }

    .github-icon svg {
        width: 100%;
        height: 100%;
    }

    .github-content h3 {
        font-family: var(--font-mono);
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .github-content p {
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.7;
        margin-bottom: 20px;
    }

    .github-features {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .github-features li {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    .github-features li::before {
        content: '✓';
        color: var(--accent-green);
        font-weight: 600;
    }

    /* Download */
    .download {
        padding: 100px 0;
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-color);
    }

    .section-subtitle {
        color: var(--text-secondary);
        font-size: 1.1rem;
        margin-top: 16px;
    }

    .platform-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 24px;
        margin-top: 48px;
    }

    .platform-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 32px;
        text-align: center;
        transition: all 0.3s ease;
    }

    .platform-card:hover {
        transform: translateY(-4px);
        border-color: var(--accent-cyan);
        box-shadow: 0 16px 32px var(--shadow-color);
    }

    .platform-icon {
        width: 48px;
        height: 48px;
        margin: 0 auto 20px;
        color: var(--accent-cyan);
    }

    .platform-icon.linux {
        color: #ffcc00;
    }

    .platform-icon.flatpak {
        color: var(--accent-purple);
    }

    .platform-icon svg {
        width: 100%;
        height: 100%;
    }

    .platform-card h3 {
        font-family: var(--font-mono);
        font-size: 1.15rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .platform-req {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-bottom: 20px;
    }

    .download-btn {
        width: 100%;
        justify-content: center;
    }

    .unavailable {
        display: block;
        padding: 14px;
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .install-hint {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-top: 12px;
    }

    .download-footer {
        display: flex;
        justify-content: center;
        gap: 32px;
        margin-top: 48px;
        flex-wrap: wrap;
    }

    .alt-link {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s ease;
    }

    .alt-link:hover {
        color: var(--accent-cyan);
    }

    @media (max-width: 768px) {
        .github-card {
            grid-template-columns: 1fr;
            text-align: center;
            padding: 32px;
        }

        .github-icon {
            margin: 0 auto;
        }

        .github-features {
            grid-template-columns: 1fr;
            text-align: left;
        }
    }

    @media (max-width: 640px) {
        .hero-cta {
            flex-direction: column;
        }

        .hero-cta .btn {
            width: 100%;
            justify-content: center;
        }

        .platform-grid {
            grid-template-columns: 1fr;
        }

        .download-footer {
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }
    }
</style>
