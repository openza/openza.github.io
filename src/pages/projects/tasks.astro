---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { TASKS_FALLBACK_VERSION, TASKS_STORE_URL, getLatestRelease } from '../../lib/github';

const release = await getLatestRelease('tasks');
const version = `WinUI ${release?.version ?? TASKS_FALLBACK_VERSION}`;
---

<Layout title="Openza Tasks - Windows Native Task Manager" description="A Windows-native, local-first task manager with SQLite, Todoist and Microsoft To Do sync, durable backups, and optional OneDrive backup.">
    <Header />
    <main>
        <!-- Hero Section -->
        <section class="hero">
            <div class="container">
                <a href="/#projects" class="back-link">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Back to Projects
                </a>
                <div class="hero-content">
                    <span class="version-badge">{version}</span>
                    <h1>Windows Native,<br><span class="highlight">Local First</span></h1>
                    <p class="hero-description">
                        Openza Tasks is a Windows-first task manager built with WinUI 3,
                        local SQLite storage, optional Todoist and Microsoft To Do sync,
                        local restore points, and optional OneDrive backup snapshots.
                    </p>
                    <div class="hero-cta">
                        <a href={TASKS_STORE_URL} class="btn btn-primary">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/>
                            </svg>
                            Get on Microsoft Store
                        </a>
                        <a href="https://github.com/openza/tasks" class="btn btn-secondary">
                            View Repository
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section class="features">
            <div class="container">
                <div class="section-header">
                    <p class="section-label">Features</p>
                    <h2 class="section-title">Everything You Need to Stay Focused</h2>
                </div>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon cyan">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
                            </svg>
                        </div>
                        <h3>Native WinUI Workspace</h3>
                        <p>Use a focused Windows task surface with navigation, projects, task lists, source intake, and details in one place.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon purple">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                            </svg>
                        </div>
                        <h3>Provider Sync</h3>
                        <p>Reconnect Todoist and Microsoft To Do when you want provider tasks inside your local Openza workspace.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon green">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </div>
                        <h3>Local-First</h3>
                        <p>Your primary task database lives on your Windows device in SQLite. Work locally first, then sync when you choose.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon orange">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/>
                            </svg>
                        </div>
                        <h3>Automatic Backups</h3>
                        <p>Automatic and manual restore points support rollback, with optional OneDrive backup snapshots for PC loss or reset scenarios.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon cyan">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                        </div>
                        <h3>Markdown Support</h3>
                        <p>Import GitHub Flavored Markdown checkboxes and export project-grouped Markdown when you want a readable copy.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon purple">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                            </svg>
                        </div>
                        <h3>Windows Accounts</h3>
                        <p>Microsoft To Do and OneDrive backup can use separate Microsoft accounts through feature-scoped sign-in.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Integrations Section -->
        <section class="integrations">
            <div class="container">
                <div class="section-header">
                    <p class="section-label">Integrations</p>
                    <h2 class="section-title">Connect Your Favorite Services</h2>
                </div>
                <div class="integrations-grid">
                    <div class="integration-card">
                        <div class="integration-icon">
                            <svg viewBox="0 0 24 24" fill="#E44332">
                                <path d="M21 0H3C1.35 0 0 1.35 0 3v18c0 1.65 1.35 3 3 3h18c1.65 0 3-1.35 3-3V3c0-1.65-1.35-3-3-3zM9.15 18.6l-4.95-4.95 1.4-1.4 3.55 3.55 7.55-7.55 1.4 1.4-8.95 8.95z"/>
                            </svg>
                        </div>
                        <h3>Todoist</h3>
                        <p>Sync your projects, tasks, and labels. Two-way sync keeps everything up to date.</p>
                    </div>
                    <div class="integration-card">
                        <div class="integration-icon">
                            <svg viewBox="0 0 24 24" fill="#3B82F6">
                                <path d="M0 0h11.5v11.5H0V0zm12.5 0H24v11.5H12.5V0zM0 12.5h11.5V24H0V12.5zm12.5 0H24V24H12.5V12.5z"/>
                            </svg>
                        </div>
                        <h3>Microsoft To Do</h3>
                        <p>Choose the Microsoft account Openza should use for Microsoft To Do sync. OneDrive backup remains separately optional.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Availability Section -->
        <section class="download" id="download">
            <div class="container">
                <div class="section-header">
                    <p class="section-label">Availability</p>
                    <h2 class="section-title">Live on Microsoft Store</h2>
                    <p class="section-subtitle">Openza Tasks v1.0.1 is the public Windows-native WinUI release line for Windows 10 22H2 and Windows 11.</p>
                </div>
                <div class="platform-grid">
                    <div class="platform-card">
                        <div class="platform-icon windows">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/>
                            </svg>
                        </div>
                        <h3>Windows</h3>
                        <p class="platform-req">Windows 10 22H2 or Windows 11</p>
                        <a href={TASKS_STORE_URL} class="btn btn-primary download-btn">
                            Get on Microsoft Store
                        </a>
                    </div>
                    <div class="platform-card">
                        <div class="platform-icon windows">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                        </div>
                        <h3>Source Code</h3>
                        <p class="platform-req">Public open-source repository</p>
                        <a href="https://github.com/openza/tasks" class="btn btn-primary download-btn">
                            View on GitHub
                        </a>
                    </div>
                </div>
                <div class="download-footer">
                    <a href="https://github.com/openza/tasks/releases" target="_blank" class="alt-link">
                        GitHub releases
                    </a>
                    <a href="https://github.com/openza/tasks#building-from-source" class="alt-link">
                        Build from source
                    </a>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<style>
    /* Hero */
    .hero {
        padding: 140px 0 80px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.9rem;
        margin-bottom: 32px;
        transition: color 0.2s ease;
    }

    .back-link:hover {
        color: var(--accent-cyan);
    }

    .hero-content {
        max-width: 700px;
    }

    .version-badge {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        padding: 6px 14px;
        background: rgba(63, 185, 80, 0.15);
        color: var(--accent-green);
        border-radius: 100px;
        margin-bottom: 24px;
    }

    .hero h1 {
        font-family: var(--font-mono);
        font-size: clamp(2.5rem, 6vw, 3.5rem);
        font-weight: 700;
        line-height: 1.1;
        margin-bottom: 24px;
    }

    .hero h1 .highlight {
        background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-purple) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-description {
        font-size: 1.2rem;
        color: var(--text-secondary);
        margin-bottom: 32px;
        line-height: 1.7;
    }

    .hero-cta {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    /* Features */
    .features {
        padding: 100px 0;
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 24px;
    }

    .feature-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 28px;
        transition: all 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-4px);
        border-color: var(--accent-cyan);
        box-shadow: 0 16px 32px var(--shadow-color);
    }

    .feature-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        margin-bottom: 16px;
    }

    .feature-icon.cyan {
        background: var(--accent-cyan-dim);
        color: var(--accent-cyan);
    }

    .feature-icon.purple {
        background: rgba(163, 113, 247, 0.15);
        color: var(--accent-purple);
    }

    .feature-icon.green {
        background: rgba(63, 185, 80, 0.15);
        color: var(--accent-green);
    }

    .feature-icon.orange {
        background: rgba(240, 136, 62, 0.15);
        color: var(--accent-orange);
    }

    .feature-card h3 {
        font-family: var(--font-mono);
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .feature-card p {
        color: var(--text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    /* Integrations */
    .integrations {
        padding: 100px 0;
    }

    .integrations-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
        max-width: 700px;
        margin: 0 auto;
    }

    .integration-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 32px;
        text-align: center;
        transition: all 0.3s ease;
    }

    .integration-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px var(--shadow-color);
    }

    .integration-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 20px;
    }

    .integration-icon svg {
        width: 100%;
        height: 100%;
    }

    .integration-card h3 {
        font-family: var(--font-mono);
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .integration-card p {
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    /* Download */
    .download {
        padding: 100px 0;
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-color);
    }

    .section-subtitle {
        color: var(--text-secondary);
        font-size: 1.1rem;
        margin-top: 16px;
    }

    .platform-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 24px;
        margin-top: 48px;
    }

    .platform-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 32px;
        text-align: center;
        transition: all 0.3s ease;
    }

    .platform-card:hover {
        transform: translateY(-4px);
        border-color: var(--accent-cyan);
        box-shadow: 0 16px 32px var(--shadow-color);
    }

    .platform-icon {
        width: 48px;
        height: 48px;
        margin: 0 auto 20px;
        color: var(--accent-cyan);
    }

    .platform-icon.linux {
        color: #ffcc00;
    }

    .platform-icon.flatpak {
        color: var(--accent-purple);
    }

    .platform-icon svg {
        width: 100%;
        height: 100%;
    }

    .platform-card h3 {
        font-family: var(--font-mono);
        font-size: 1.15rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .platform-req {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-bottom: 20px;
    }

    .download-btn {
        width: 100%;
        justify-content: center;
    }

    .unavailable {
        display: block;
        padding: 14px;
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .install-hint {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-top: 12px;
    }

    .download-footer {
        display: flex;
        justify-content: center;
        gap: 32px;
        margin-top: 48px;
        flex-wrap: wrap;
    }

    .alt-link {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s ease;
    }

    .alt-link:hover {
        color: var(--accent-cyan);
    }

    @media (max-width: 640px) {
        .hero-cta {
            flex-direction: column;
        }

        .hero-cta .btn {
            width: 100%;
            justify-content: center;
        }

        .platform-grid {
            grid-template-columns: 1fr;
        }

        .download-footer {
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }
    }
</style>
